# ─── Copy this file to .env and fill in your real values ───

# D-ID API Key (from studio.d-id.com → Profile → API)
DID_API_KEY=your_did_api_key_here

# ElevenLabs API Key (from elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# PayMongo Keys (from dashboard.paymongo.com → Developers → API Keys)
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_paymongo_webhook_secret

# Your frontend domain (e.g. https://babytalk-taupe.vercel.app)
FRONTEND_URL=https://babytalk-taupe.vercel.app

# Price per video in centavos (50000 = PHP 500.00)
PRICE_PER_VIDEO_CENTS=50000

# Port (Vercel sets this automatically)
PORT=3000
