# ─── Copy this file to .env and fill in your real values ───

# D-ID API Key (from studio.d-id.com → Profile → API)
DID_API_KEY=your_did_api_key_here

# ElevenLabs API Key (from elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stripe Keys (from dashboard.stripe.com → Developers → API Keys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Your frontend domain (for CORS — e.g. https://yourdomain.com)
FRONTEND_URL=https://yourdomain.com

# Pricing — how much to charge per video in cents (500 = $5.00)
PRICE_PER_VIDEO_CENTS=500

# Port (Railway sets this automatically, leave as is)
PORT=3000
